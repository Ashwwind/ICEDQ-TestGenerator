<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Suite" parallel="tests" thread-count="1">

	<test name="Login Tests">
		<classes>
			<class name="com.qa.tests.LoginTest">
				<methods>
					<include name="validateLoginPage" />
					<include name="Login" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="Home Page Tests">
		<classes>
			<class name="com.qa.tests.HomePageTest">
				<methods>
					<include name="validateHomePage" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="Test Generator Page Tests">
		<classes>
			<class name="com.qa.tests.TestGeneratorTest">
				<methods>
					<exclude name="createRuleUsingDynamicTemplate" />
					<exclude name="createRuleUsingImportTemplate" />
					<exclude name="createWorkflowUsingDefaultDynamicTemplate" />
					<exclude name="existingWorkflowUsingDefaultDynamicTemplate"/>
				</methods>
			</class>
		</classes>
	</test>

	<test name="Template Page Tests">
		<classes>
			<class name="com.qa.tests.TemplatePageTest">
				<methods>
					<include name="createTemplateUsingDynamicTemplate" />
					<include name="updateTemplateUsingExistingTemplate" />
					<include name="deleteTemplateUsingExistingTemplateFromList" />
					<include name="deleteTemplateUsingExistingTemplateFromDetails" />
				</methods>
			</class>
		</classes>
	</test>

</suite>
