<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ICEDQ-TestGenerator Suite"
       parallel="none"
       verbose="2">

    <listeners>
        <listener class-name="com.qa.extentreportlistener.ExtentReportListener"/>
    </listeners>

    <test name="ICEDQ End-to-End Tests" preserve-order="true">

        <classes>

            <!-- Login -->
            <class name="com.qa.tests.LoginTest">
                <methods>
                    <include name="validateLoginPage"/>
                    <include name="Login"/>
                </methods>
            </class>

            <!-- Home -->
            <class name="com.qa.tests.HomePageTest">
                <methods>
                    <include name="validateHomePage"/>
                </methods>
            </class>

            <!-- Test Generator -->
            <class name="com.qa.tests.TestGeneratorTest">
                <methods>
                    <include name="createRuleUsingDynamicTemplate"/>
                    <include name="createRuleUsingImportTemplate"/>
                    <include name="createWorkflowUsingDefaultDynamicTemplate"/>
                    <include name="existingWorkflowUsingDefaultDynamicTemplate"/>
                </methods>
            </class>

            <!-- Template -->
            <class name="com.qa.tests.TemplatePageTest">
                <methods>
                    <include name="createTemplate"/>
                    <include name="updateTemplate"/>
                    <include name="deleteTemplateFromDetailsPage"/>
                    <include name="deleteTemplateFromListingPage"/>
                </methods>
            </class>

        </classes>

    </test>

</suite>
